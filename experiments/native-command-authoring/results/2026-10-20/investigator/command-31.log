Verification.split_save_restore_resume : ∀ (self : adler2.Adler32) (xs ys : Aeneas.Std.Slice Aeneas.Std.U8)
  (hcat : (↑xs).length + (↑ys).length ≤ Aeneas.Std.Usize.max),
  (do
      let s ← self.write_slice xs
      let c ← s.checksum
      let restored ← adler2.Adler32.from_checksum c
      restored.write_slice ys) =
    self.write_slice (Verification.concatSlice xs ys hcat)
'Verification.split_save_restore_resume' depends on axioms: [propext, Classical.choice, Quot.sound]
