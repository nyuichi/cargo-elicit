elicit_contract ElicitContracts.c_0dfc1ce11e75ed00 for ElicitGenerated.algo.U32X4.from requires (fun (bytes : Aeneas.Std.Slice Aeneas.Std.U8) => 4 ≤ bytes.val.length) ensures (fun (bytes : Aeneas.Std.Slice Aeneas.Std.U8) (out : ElicitGenerated.algo.U32X4) => ∀ i : Nat, i < 4 → (out.val[i]!).val = (bytes.val[i]!).val)
elicit_contract ElicitContracts.c_f321f3834d6c15c0 for ElicitGenerated.algo.U32X4.Insts.CoreOpsArithRemAssignU32.rem_assign requires (fun (_self : ElicitGenerated.algo.U32X4) (q : Aeneas.Std.U32) => q.val ≠ 0) ensures (fun (self : ElicitGenerated.algo.U32X4) (q : Aeneas.Std.U32) (out : ElicitGenerated.algo.U32X4) => ∀ i : Nat, i < 4 → (out.val[i]!).val = (self.val[i]!).val % q.val)
elicit_contract ElicitContracts.c_6c7496278e307fe7 for ElicitGenerated.algo.U32X4.Insts.CoreOpsArithMulAssignU32.mul_assign requires (fun (self : ElicitGenerated.algo.U32X4) (rhs : Aeneas.Std.U32) => ∀ i : Nat, i < 4 → (self.val[i]!).val * rhs.val < 2 ^ 32) ensures (fun (self : ElicitGenerated.algo.U32X4) (rhs : Aeneas.Std.U32) (out : ElicitGenerated.algo.U32X4) => ∀ i : Nat, i < 4 → (out.val[i]!).val = (self.val[i]!).val * rhs.val)
elicit_contract ElicitContracts.c_20b5198a3591154d for ElicitGenerated.algo.U32X4.Insts.CoreOpsArithAddAssignU32X4.add_assign requires (fun (self other : ElicitGenerated.algo.U32X4) => ∀ i : Nat, i < 4 → (self.val[i]!).val + (other.val[i]!).val < 2 ^ 32) ensures (fun (self other out : ElicitGenerated.algo.U32X4) => ∀ i : Nat, i < 4 → (out.val[i]!).val = (self.val[i]!).val + (other.val[i]!).val)
elicit_contract ElicitContracts.c_2fa15a7d1ba5a684 for ElicitGenerated.Adler32.Insts.CoreDefaultDefault.default requires (by intros; exact True) ensures (fun (out : ElicitGenerated.Adler32) => out.a.val = 1 ∧ out.b.val = 0)
elicit_contract ElicitContracts.c_375e1cdaf1f944d2 for ElicitGenerated.Adler32.Insts.CoreHashHasher.finish requires (by intros; exact True) ensures (fun (self : ElicitGenerated.Adler32) (out : Aeneas.Std.U64) => out.val = 65536 * self.b.val + self.a.val)
elicit_contract ElicitContracts.c_0a059b8c0885cf07 for ElicitGenerated.Adler32.checksum requires (by intros; exact True) ensures (fun (self : ElicitGenerated.Adler32) (out : Aeneas.Std.U32) => out.val = 65536 * self.b.val + self.a.val)
elicit_contract ElicitContracts.c_9a31b7b9cb8492b0 for ElicitGenerated.Adler32.from_checksum requires (by intros; exact True) ensures (fun (sum : Aeneas.Std.U32) (out : ElicitGenerated.Adler32) => out.a.val = sum.val % 65536 ∧ out.b.val = sum.val / 65536)
