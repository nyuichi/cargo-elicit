        },
        {
          "goal": "adler2::adler32_slice::Function",
          "id": "lane_mul_spec",
          "kind": "lemma",
          "needs": [],
          "reason": "The original recombination multiplies all four reduced b lanes by four; this rule covers the four checked indexing, multiplication and update operations.",
          "statement": "∀ (a : ElicitGenerated.algo.U32X4) (q : Aeneas.Std.U32)\n    (h : ∀ i, AdlerSpec.laneVal a i * q.val ≤ Aeneas.Std.U32.max),\n    ElicitGenerated.algo.U32X4.Insts.CoreOpsArithMulAssignU32.mul_assign a q ⦃ out =>\n      AdlerSpec.vals out = (AdlerSpec.vals a).map (fun x => x*q.val) ⦄",
