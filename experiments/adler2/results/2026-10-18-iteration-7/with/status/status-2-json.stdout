        "kind": "lemma",
        "needs": [],
        "reason": "Combine scalar recurrence summaries across the complete chunks, final partial chunk, and final byte remainder in compute.",
        "statement": "∀ (a b : Nat) (xs ys : List Aeneas.Std.U8), AdlerSpec.update a b (xs ++ ys) = AdlerSpec.update (AdlerSpec.update a b xs).1 (AdlerSpec.update a b xs).2 ys",
