        "id": "chunks_exact_execution",
        "kind": "lemma",
        "needs": [],
        "reason": "The compute body proof stops at chunks_exact. Exact chunk lengths justify four-byte U32X4::from indexing; reconstruction and the strict remainder bound connect chunk processing to the scalar input recurrence and bound the final partial chunk.",
        "statement": "∀ {α : Type} (s : Aeneas.Std.Slice α) (n : Aeneas.Std.Usize), 0 < n.val → Aeneas.Std.core.slice.Slice.chunks_exact s n ⦃ it => (it.chunks.map Aeneas.Std.Slice.val).flatten ++ it.remainder.val = s.val ∧ (∀ c ∈ it.chunks, c.val.length = n.val) ∧ it.remainder.val.length < n.val ⦄",
        "target": null,
        "theorem": "AdlerSpec.chunks_exact_spec"
      },
      {
        "goal": "adler2::adler32_slice::Function",
        "id": "lane_load",
        "kind": "contract",
        "needs": [
          "chunks_exact_execution"
        ],
        "reason": "The nested lane loop calls the original loader on each four-byte chunk; exact chunk length supplies its indexing precondition and its result supplies the byte values used by the lane recurrence.",
        "statement": null,
        "target": "adler2::algo::impl[16f54fa5277eca59]::from::Method",
