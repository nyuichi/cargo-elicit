        "kind": "lemma",
        "needs": [],
        "reason": "The two byte-lane loops need an overflow bound for their running weighted sums between reductions.",
        "statement": "∀ n a b : Nat, n ≤ 5552 → a ≤ 65520 → b ≤ 65520 → b + n * a + 255 * (n * (n + 1) / 2) < 4294967296",
        "target": null,
        "theorem": "AdlerProof.lane_bound"
      },
      {
        "goal": "adler2::adler32_slice::Function",
        "id": "chunks_lengths",
        "kind": "lemma",
        "needs": [],
        "reason": "The four-byte constructor indexes positions 0 through 3; every inner chunk must have exactly four bytes, rather than merely at most four.",
        "statement": "∀ {α : Type} {n : Nat} (hn : 0 < n) (xs : List α), ∀ c ∈ (Aeneas.Std.List.toChunksExact n hn xs).1, c.length = n",
        "target": null,
        "theorem": "AdlerProof.chunks_exact_lengths"
      },
      {
        "goal": "adler2::adler32_slice::Function",
        "id": "chunks_tail_bound",
        "kind": "lemma",
        "needs": [],
        "reason": "The final outer remainder must be shorter than 22208 for its u32 cast and seed-product overflow bound.",
        "statement": "∀ {α : Type} {n : Nat} (hn : 0 < n) (xs : List α), (Aeneas.Std.List.toChunksExact n hn xs).2.length < n",
        "target": null,
        "theorem": "AdlerProof.chunks_remainder_lt"
      },
      {
        "goal": "adler2::adler32_slice::Function",
        "id": "chunks_reconstruct",
        "kind": "lemma",
        "needs": [],
        "reason": "Scalar correctness requires that processed full chunks and the final remainder cover the original bytes in order.",
        "statement": "∀ {α : Type} {n : Nat} (hn : 0 < n) (xs : List α), (Aeneas.Std.List.toChunksExact n hn xs).1.flatten ++ (Aeneas.Std.List.toChunksExact n hn xs).2 = xs",
        "target": null,
        "theorem": "AdlerProof.chunks_reconstruct"
      },
      {
        "goal": "adler2::adler32_slice::Function",
        "id": "chunks_rule",
        "kind": "lemma",
        "needs": [
          "chunks_lengths",
          "chunks_tail_bound",
          "chunks_reconstruct"
        ],
        "reason": "The original compute proof stops at chunks_exact; export exact lengths, remainder bound and reconstruction for the actual standard-model return value.",
        "statement": "∀ {α : Type} (s : Aeneas.Std.Slice α) (n : Aeneas.Std.Usize) (hn : 0 < n.val), Aeneas.Std.core.slice.Slice.chunks_exact s n ⦃ it => it.chunks.map Aeneas.Std.Slice.val = (Aeneas.Std.List.toChunksExact n.val hn s.val).1 ∧ it.remainder.val = (Aeneas.Std.List.toChunksExact n.val hn s.val).2 ∧ (∀ c ∈ it.chunks, c.length = n.val) ∧ it.remainder.length < n.val ∧ (it.chunks.map Aeneas.Std.Slice.val).flatten ++ it.remainder.val = s.val ⦄",
        "target": null,
        "theorem": "AdlerProof.chunks_exact_spec"
