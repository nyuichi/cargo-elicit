        {
          "goal": "adler2::adler32_slice::Function",
          "id": "inner_step",
          "kind": "lemma",
          "needs": [
            "vector_from",
            "vector_add"
          ],
          "reason": "Checks the original inner-loop body, including iterator next, constructor, both vector updates and the returned next iterator. Remaining loop proof must establish these arithmetic preconditions and use the strictly shorter chunk list.",
          "statement": "∀  (chunk remainder : Slice U8) (chunks : List (Slice U8))\n     (a b : algo.U32X4) (hc : 4 ≤ chunk.length)\n     (ha : ∀ i : Fin 4, AdlerSpec.lane a i + chunk.val[i.val]!.val ≤ U32.max)\n     (hb : ∀ i : Fin 4, AdlerSpec.lane b i + (AdlerSpec.lane a i + chunk.val[i.val]!.val) ≤ U32.max),\n     algo.Adler32.compute_loop0_loop0.body ⟨chunk :: chunks, remainder⟩ a b ⦃ r =>\n       ∃ av bv, r = ControlFlow.cont (⟨chunks, remainder⟩, av, bv) ∧\n       ∀ i : Fin 4,\n         AdlerSpec.lane av i = AdlerSpec.lane a i + chunk.val[i.val]!.val ∧\n         AdlerSpec.lane bv i = AdlerSpec.lane b i + (AdlerSpec.lane a i + chunk.val[i.val]!.val) ⦄",
          "target": null,
          "theorem": "AdlerProof.inner_step_spec"
        },
        {
          "goal": "adler2::adler32_slice::Function",
