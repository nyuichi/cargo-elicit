@AdlerProof.chunks_exact_spec : ∀ {α : Type} (s : Aeneas.Std.Slice α) (n : Aeneas.Std.Usize) (hn : 0 < ↑n),
  Aeneas.Std.core.slice.Slice.chunks_exact s n ⦃ it =>
    List.map Aeneas.Std.Slice.val it.chunks = (Aeneas.Std.List.toChunksExact (↑n) hn ↑s).1 ∧
      ↑it.remainder = (Aeneas.Std.List.toChunksExact (↑n) hn ↑s).2 ∧
        (∀ c ∈ it.chunks, c.length = ↑n) ∧
          it.remainder.length < ↑n ∧ (List.map Aeneas.Std.Slice.val it.chunks).flatten ++ ↑it.remainder = ↑s ⦄
theorem IndependentLemma_4 : ∀ {α : Type} (s : Aeneas.Std.Slice α) (n : Aeneas.Std.Usize) (hn : 0 < ↑n),
  Aeneas.Std.core.slice.Slice.chunks_exact s n ⦃ it =>
    List.map Aeneas.Std.Slice.val it.chunks = (Aeneas.Std.List.toChunksExact (↑n) hn ↑s).1 ∧
      ↑it.remainder = (Aeneas.Std.List.toChunksExact (↑n) hn ↑s).2 ∧
        (∀ c ∈ it.chunks, c.length = ↑n) ∧
          it.remainder.length < ↑n ∧ (List.map Aeneas.Std.Slice.val it.chunks).flatten ++ ↑it.remainder = ↑s ⦄ :=
fun {α} => AdlerProof.chunks_exact_spec
'IndependentLemma_4' depends on axioms: [propext, Classical.choice, Quot.sound]
