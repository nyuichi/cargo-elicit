      "steps": [
        {
          "goal": "adler2::adler32_slice::Function",
          "id": "new_seed",
          "kind": "contract",
          "needs": [],
          "reason": "The original caller first binds Adler32.new; its result must be exactly the recurrence seed (1,0).",
          "statement": null,
          "target": "adler2::impl[ff6e69000b04949b]::new::Method",
          "theorem": null
        },
        {
          "goal": "adler2::adler32_slice::Function",
          "id": "write_recurrence",
          "kind": "contract",
          "needs": [
            "chunks_exact_spec",
            "update_eq_raw",
            "lane_chunk_fits_u32",
            "raw_four"
          ],
          "reason": "The second bind needs successful execution and the scalar recurrence for arbitrary state and bytes, including normalized empty updates; the generated body delegates to optimized compute with five loops.",
          "statement": null,
          "target": "adler2::impl[ff6e69000b04949b]::write_slice::Method",
          "theorem": null
        },
        {
          "goal": "adler2::adler32_slice::Function",
          "id": "encode_state",
          "kind": "contract",
          "needs": [],
          "reason": "The final call must encode the recurrence pair as 65536*b+a for every representable state.",
          "statement": null,
          "target": "adler2::impl[ff6e69000b04949b]::checksum::Method",
          "theorem": null
        },
        {
          "goal": "adler2::adler32_slice::Function",
          "id": "integrate_slice",
          "kind": "integrate",
          "needs": [
            "new_seed",
            "write_recurrence",
            "encode_state"
          ],
          "reason": "Compose checked seed, update, and encoding rules at the original translated caller.",
          "statement": null,
          "target": "adler2::adler32_slice::Function",
          "theorem": null
        },
        {
          "goal": "adler2::adler32_slice::Function",
          "id": "chunks_partition",
          "kind": "lemma",
          "needs": [],
          "reason": "Exact chunk lengths justify four indexed byte reads and the 5552 lane-iteration bound; flattening preserves original byte order.",
          "statement": "∀ {α : Type} (n : Nat) (hn : 0 < n) (xs : List α), (List.toChunksExact n hn xs).1.flatten ++ (List.toChunksExact n hn xs).2 = xs ∧ (∀ c ∈ (List.toChunksExact n hn xs).1, c.length = n) ∧ (List.toChunksExact n hn xs).2.length < n",
          "target": null,
          "theorem": "AdlerSpec.chunks_partition"
        },
        {
          "goal": "adler2::adler32_slice::Function",
          "id": "step_eq_normalize_raw",
          "kind": "lemma",
          "needs": [],
          "reason": "Relates the declared scalar recurrence to the unbounded arithmetic used for deferred reductions.",
          "statement": "∀ (s : Nat × Nat) (x : Aeneas.Std.U8), AdlerSpec.step s x = AdlerSpec.normalize (AdlerSpec.rawStep s x)",
          "target": null,
          "theorem": "AdlerSpec.step_eq_normalize_raw"
        },
        {
          "goal": "adler2::adler32_slice::Function",
          "id": "normalize_rawStep",
          "kind": "lemma",
          "needs": [],
          "reason": "Shows normalization commutes with the next scalar byte update, including arbitrary initial halves.",
          "statement": "∀ (s : Nat × Nat) (x : Aeneas.Std.U8), AdlerSpec.normalize (AdlerSpec.rawStep (AdlerSpec.normalize s) x) = AdlerSpec.normalize (AdlerSpec.rawStep s x)",
          "target": null,
          "theorem": "AdlerSpec.normalize_rawStep"
        },
        {
          "goal": "adler2::adler32_slice::Function",
          "id": "update_eq_raw",
          "kind": "lemma",
          "needs": [
            "step_eq_normalize_raw",
            "normalize_rawStep"
          ],
          "reason": "Discharges modular deferral in the functional postcondition after proving the optimized loop computes unreduced sums modulo 65521.",
          "statement": "∀ (s : Nat × Nat) (xs : List Aeneas.Std.U8), AdlerSpec.update s xs = AdlerSpec.normalize (xs.foldl AdlerSpec.rawStep s)",
          "target": null,
          "theorem": "AdlerSpec.update_eq_raw"
        },
        {
          "goal": "adler2::adler32_slice::Function",
          "id": "raw_fold_bounds",
          "kind": "lemma",
          "needs": [],
          "reason": "Bounds a lane and its prefix-sum accumulator for every byte prefix; required for checked u32 additions in inner loops.",
          "statement": "∀ (s : Nat × Nat) (xs : List Aeneas.Std.U8), (xs.foldl AdlerSpec.rawStep s).1 ≤ s.1 + 255 * xs.length ∧ 2 * (xs.foldl AdlerSpec.rawStep s).2 ≤ 2 * s.2 + 2 * xs.length * s.1 + 255 * xs.length * (xs.length + 1)",
          "target": null,
          "theorem": "AdlerSpec.raw_fold_bounds"
        },
        {
          "goal": "adler2::adler32_slice::Function",
          "id": "lane_chunk_fits_u32",
          "kind": "lemma",
          "needs": [
            "raw_fold_bounds"
          ],
          "reason": "Discharges inner-loop u32 overflow inequalities for at most 5552 lane updates between reductions.",
          "statement": "∀ (s : Nat × Nat) (xs : List Aeneas.Std.U8), s.1 ≤ 65520 → s.2 ≤ 65520 → xs.length ≤ 5552 → (xs.foldl AdlerSpec.rawStep s).1 < 4294967296 ∧ (xs.foldl AdlerSpec.rawStep s).2 < 4294967296",
          "target": null,
          "theorem": "AdlerSpec.lane_chunk_fits_u32"
        },
        {
          "goal": "adler2::adler32_slice::Function",
          "id": "raw_four",
          "kind": "lemma",
          "needs": [],
          "reason": "Supplies the four-byte weighted scalar identity needed to reconnect parallel lanes to the original byte recurrence.",
          "statement": "∀ (s : Nat × Nat) (x0 x1 x2 x3 : Aeneas.Std.U8), [x0,x1,x2,x3].foldl AdlerSpec.rawStep s = (s.1 + x0.val + x1.val + x2.val + x3.val, s.2 + 4 * s.1 + 4 * x0.val + 3 * x1.val + 2 * x2.val + x3.val)",
          "target": null,
          "theorem": "AdlerSpec.raw_four"
        },
        {
          "goal": "adler2::adler32_slice::Function",
          "id": "chunks_exact_spec",
          "kind": "lemma",
          "needs": [
            "chunks_partition"
          ],
          "reason": "Caller-facing rule advances the original optimized body past chunk construction and exposes exact lengths and byte decomposition.",
          "statement": "∀ (s : Aeneas.Std.Slice Aeneas.Std.U8) (n : Aeneas.Std.Usize), 0 < n.val → Aeneas.Std.core.slice.Slice.chunks_exact s n ⦃ fun it => (it.chunks.map Aeneas.Std.Slice.val).flatten ++ it.remainder.val = s.val ∧ (∀ c ∈ it.chunks, c.val.length = n.val) ∧ it.remainder.val.length < n.val ⦄",
          "target": null,
          "theorem": "AdlerSpec.chunks_exact_spec"
        }
      ]
    },
