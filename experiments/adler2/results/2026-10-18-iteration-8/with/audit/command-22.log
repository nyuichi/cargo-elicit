AdlerSpec.raw_four : ∀ (s : ℕ × ℕ) (x0 x1 x2 x3 : Aeneas.Std.U8),
  List.foldl AdlerSpec.rawStep s [x0, x1, x2, x3] =
    (s.1 + ↑x0 + ↑x1 + ↑x2 + ↑x3, s.2 + 4 * s.1 + 4 * ↑x0 + 3 * ↑x1 + 2 * ↑x2 + ↑x3)
theorem IndependentLemma_10 : ∀ (s : ℕ × ℕ) (x0 x1 x2 x3 : Aeneas.Std.U8),
  List.foldl AdlerSpec.rawStep s [x0, x1, x2, x3] =
    (s.1 + ↑x0 + ↑x1 + ↑x2 + ↑x3, s.2 + 4 * s.1 + 4 * ↑x0 + 3 * ↑x1 + 2 * ↑x2 + ↑x3) :=
AdlerSpec.raw_four
