@AdlerProof.exact_chunks_remainder_lt : ∀ {α : Type} {n : ℕ} (hn : 0 < n) (xs : List α),
  (Aeneas.Std.List.toChunksExact n hn xs).2.length < n
theorem IndependentLemma_13 : ∀ {α : Type} {n : ℕ} (hn : 0 < n) (xs : List α),
  (Aeneas.Std.List.toChunksExact n hn xs).2.length < n :=
fun {α} {n} => AdlerProof.exact_chunks_remainder_lt
'IndependentLemma_13' depends on axioms: [propext, Classical.choice, Quot.sound]
