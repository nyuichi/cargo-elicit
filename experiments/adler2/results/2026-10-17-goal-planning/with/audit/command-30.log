@AdlerProof.exact_chunks_reconstruct : ∀ {α : Type} {n : ℕ} (hn : 0 < n) (xs : List α),
  (Aeneas.Std.List.toChunksExact n hn xs).1.flatten ++ (Aeneas.Std.List.toChunksExact n hn xs).2 = xs
theorem IndependentLemma_14 : ∀ {α : Type} {n : ℕ} (hn : 0 < n) (xs : List α),
  (Aeneas.Std.List.toChunksExact n hn xs).1.flatten ++ (Aeneas.Std.List.toChunksExact n hn xs).2 = xs :=
fun {α} {n} => AdlerProof.exact_chunks_reconstruct
'IndependentLemma_14' depends on axioms: [propext, Classical.choice, Quot.sound]
