def Verification.scalar : ℕ × ℕ → List Aeneas.Std.U8 → ℕ × ℕ :=
fun s xs => List.foldl Verification.scalarStep (Verification.normalize s) xs
def Verification.scalarStep : ℕ × ℕ → Aeneas.Std.U8 → ℕ × ℕ :=
fun s x =>
  have a := (s.1 + ↑x) % 65521;
  (a, (s.2 + a) % 65521)
def Verification.normalize : ℕ × ℕ → ℕ × ℕ :=
fun s => (s.1 % 65521, s.2 % 65521)
