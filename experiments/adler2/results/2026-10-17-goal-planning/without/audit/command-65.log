                                                                    (congrArg Aeneas.Std.Array.val
                                                                      (Aeneas.Std.Array.from.congr_simp
                                                                        (List.replicate (↑4#usize) 0#u32)
                                                                        [0#u32, 0#u32, ⋯, ⋯]
                                                                        (congrFun'
                                                                          (congrArg List.replicate
                                                                            (Aeneas.Std.UScalar.ofNatCore_val_eq ⋯))
                                                                          0#u32)
                                                                        (Aeneas.Std.Array.repeat._proof_1 4#usize
                                                                          0#u32)))
                                                                    (Aeneas.Std.Array.from_val [0#u32, 0#u32, 0#u32, ⋯]
                                                                      (congrFun'
                                                                          (congrArg List.replicate
                                                                            (Aeneas.Std.UScalar.ofNatCore_val_eq ⋯))
                                                                          0#u32 ▸
                                                                        Aeneas.Std.Array.repeat._proof_1 4#usize
                                                                          0#u32)))
                                                                  (↑j) 3 hc
                                                                  (Verification.lane._proof_1
                                                                    (Aeneas.Std.Array.repeat 4#usize 0#u32) j)))
                                                              (Aeneas.Std.UScalar.ofNatCore_val_eq
                                                                (Aeneas.Std.UScalar.bound_suffices
                                                                  Aeneas.Std.UScalarTy.U32 0
                                                                  (of_decide_eq_true (id (Eq.refl true)))))))
                                                          (Eq.trans (congrArg (HAdd.hAdd 65520) (zero_mul 255))
                                                            (add_zero 65520)))
                                                        zero_le._simp_1))
                                                    (Eq.trans
                                                      (congr
                                                        (congrArg LE.le
                                                          (Eq.trans
                                                            (congrArg (HMul.hMul 2)
                                                              (Eq.trans
                                                                (congrArg Aeneas.Std.UScalar.val
                                                                  (GetElem.getElem.congr_simp
                                                                    ↑(Aeneas.Std.Array.repeat 4#usize 0#u32)
                                                                    [0#u32, 0#u32, 0#u32, 0#u32]
                                                                    (Eq.trans
                                                                      (congrArg Aeneas.Std.Array.val
                                                                        (Aeneas.Std.Array.from.congr_simp
                                                                          (List.replicate (↑⋯) 0#u32) [0#u32, ⋯, ⋯]
                                                                          (congrFun' (congrArg List.replicate ⋯) 0#u32)
                                                                          (Aeneas.Std.Array.repeat._proof_1 4#usize
                                                                            0#u32)))
                                                                      (Aeneas.Std.Array.from_val [0#u32, 0#u32, ⋯, ⋯]
                                                                        (congrFun' (congrArg List.replicate ⋯) 0#u32 ▸
                                                                          Aeneas.Std.Array.repeat._proof_1 4#usize
                                                                            0#u32)))
                                                                    (↑j) 3 hc
                                                                    (Verification.lane._proof_1
                                                                      (Aeneas.Std.Array.repeat 4#usize 0#u32) j)))
                                                                (Aeneas.Std.UScalar.ofNatCore_val_eq
                                                                  (Aeneas.Std.UScalar.bound_suffices
                                                                    Aeneas.Std.UScalarTy.U32 0
                                                                    (of_decide_eq_true (id (Eq.refl true)))))))
                                                            (mul_zero 2)))
                                                        (Eq.trans
                                                          (congr
                                                            (congrArg HAdd.hAdd
                                                              (Eq.trans
                                                                (congrArg (HAdd.hAdd 131040)
                                                                  (Eq.trans
                                                                    (congrFun' (congrArg HMul.hMul (mul_zero 2)) 65520)
                                                                    (zero_mul 65520)))
                                                                (add_zero 131040)))
                                                            (Eq.trans
                                                              (congr (congrArg HMul.hMul (mul_zero 255)) (zero_add 1))
                                                              (mul_one 0)))
                                                          (add_zero 131040)))
                                                      zero_le._simp_1))
                                                  (and_self True));
                                    Aeneas.Std.WP.spec_bind
                                      (Verification.outer_loop x_4.chunks x_4.remainder
                                        (Aeneas.Std.core.convert.num.FromU32U16.from self.a)
                                        (Aeneas.Std.core.convert.num.FromU32U16.from self.b)
                                        (Aeneas.Std.Array.repeat 4#usize 0#u32) (Aeneas.Std.Array.repeat 4#usize 0#u32)
                                        (Eq.mpr (id (congrFun' ⋯ ⋯)) ⋯) ⋯ ⋯ ⋯)
                                      ⋯))))))))))
theorem Verification.write_slice_correct : ∀ (self : adler2.Adler32) (bytes : Aeneas.Std.Slice Aeneas.Std.U8),
  Aeneas.Std.WP.spec (self.write_slice bytes) fun r => (↑r.a, ↑r.b) = Verification.scalar (↑self.a, ↑self.b) ↑bytes :=
fun self bytes => Verification.compute_correct self bytes
theorem Verification.adler32_slice_correct : ∀ (bytes : Aeneas.Std.Slice Aeneas.Std.U8),
  Aeneas.Std.WP.spec (adler2.adler32_slice bytes) fun sum =>
    ↑sum = 65536 * (Verification.scalar (1, 0) ↑bytes).2 + (Verification.scalar (1, 0) ↑bytes).1 :=
fun bytes =>
  id
    (Eq.mpr
      (id
        (congrArg
          (fun _a =>
            Aeneas.Std.WP.spec
              (do
                let h ← _a
                let h1 ← h.write_slice bytes
                h1.checksum)
              fun sum => ↑sum = 65536 * (Verification.scalar (1, 0) ↑bytes).2 + (Verification.scalar (1, 0) ↑bytes).1)
          Verification.new_correct))
      (Eq.mpr
        (id
          (congrFun'
            (congrArg Aeneas.Std.WP.spec
              (Aeneas.Std.bind_ok { a := 1#u16, b := 0#u16 } fun h => do
                let h1 ← h.write_slice bytes
                h1.checksum))
            fun sum => ↑sum = 65536 * (Verification.scalar (1, 0) ↑bytes).2 + (Verification.scalar (1, 0) ↑bytes).1))
        (Aeneas.Std.WP.spec_bind (Verification.write_slice_correct { a := 1#u16, b := 0#u16 } bytes)
          ((of_eq_true
                (iff_self
                  (∀ (x : adler2.Adler32),
                    (↑x.a, ↑x.b) = Verification.scalar (↑1#u16, ↑0#u16) ↑bytes →
                      Aeneas.Std.WP.spec x.checksum fun sum =>
                        ↑sum =
                          65536 * (Verification.scalar (1, 0) ↑bytes).2 + (Verification.scalar (1, 0) ↑bytes).1))).mpr
            fun x hh =>
            Aeneas.Std.WP.spec_mono (Verification.checksum_correct x)
              ((of_eq_true
                    (iff_self
                      (∀ (x_1 : Aeneas.Std.U32),
                        ↑x_1 = 65536 * ↑x.b + ↑x.a →
                          ↑x_1 =
                            65536 * (Verification.scalar (1, 0) ↑bytes).2 + (Verification.scalar (1, 0) ↑bytes).1))).mpr
                fun x_1 hsum =>
                have ha :=
                  congrArg Prod.fst
                    (Eq.mp
                      (congrArg (Eq (↑x.a, ↑x.b))
                        (congrFun'
                          (congrArg Verification.scalar
                            (congr
                              (congrArg Prod.mk
                                (Aeneas.Std.UScalar.ofNatCore_val_eq
                                  (Aeneas.Std.UScalar.bound_suffices Aeneas.Std.UScalarTy.U16 1
                                    (of_decide_eq_true (id (Eq.refl true))))))
                              (Aeneas.Std.UScalar.ofNatCore_val_eq
                                (Aeneas.Std.UScalar.bound_suffices Aeneas.Std.UScalarTy.U16 0
                                  (of_decide_eq_true (id (Eq.refl true)))))))
                          ↑bytes))
                      hh);
                have hb :=
                  congrArg Prod.snd
                    (Eq.mp
                      (congrArg (Eq (↑x.a, ↑x.b))
                        (congrFun'
                          (congrArg Verification.scalar
                            (congr
                              (congrArg Prod.mk
                                (Aeneas.Std.UScalar.ofNatCore_val_eq
                                  (Aeneas.Std.UScalar.bound_suffices Aeneas.Std.UScalarTy.U16 1
                                    (of_decide_eq_true (id (Eq.refl true))))))
                              (Aeneas.Std.UScalar.ofNatCore_val_eq
                                (Aeneas.Std.UScalar.bound_suffices Aeneas.Std.UScalarTy.U16 0
                                  (of_decide_eq_true (id (Eq.refl true)))))))
                          ↑bytes))
                      hh);
                of_eq_true
                  (Eq.trans
                    (Eq.trans
                      (congrFun'
                        (congrArg Eq
                          (Eq.trans hsum
                            (congr (congrArg HAdd.hAdd (congrArg (HMul.hMul 65536) (id (id hb)))) (id (id ha)))))
                        (65536 * (Verification.scalar (1, 0) ↑bytes).2 + (Verification.scalar (1, 0) ↑bytes).1))
                      Nat.add_left_cancel_iff._simp_1)
                    (eq_self (Verification.scalar (1, 0) ↑bytes).1)))))))
