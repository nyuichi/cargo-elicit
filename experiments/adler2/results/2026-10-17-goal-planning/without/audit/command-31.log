Verification.vector_add_lane : ∀ (v w : adler2.algo.U32X4),
  (∀ (j : Fin 4), Verification.lane v j + Verification.lane w j ≤ Aeneas.Std.U32.max) →
    Aeneas.Std.WP.spec (adler2.algo.U32X4.Insts.CoreOpsArithAddAssignU32X4.add_assign v w) fun r =>
      ∀ (j : Fin 4), Verification.lane r j = Verification.lane v j + Verification.lane w j
'Verification.vector_add_lane' depends on axioms: [propext, Classical.choice, Quot.sound]
