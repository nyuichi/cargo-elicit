Verification.vector_from_lane : ∀ (bytes : Aeneas.Std.Slice Aeneas.Std.U8),
  (↑bytes).length = 4 →
    Aeneas.Std.WP.spec (adler2.algo.U32X4.from bytes) fun r => ∀ (j : Fin 4), Verification.lane r j = ↑(↑bytes)[↑j]!
'Verification.vector_from_lane' depends on axioms: [propext, Classical.choice, Quot.sound]
