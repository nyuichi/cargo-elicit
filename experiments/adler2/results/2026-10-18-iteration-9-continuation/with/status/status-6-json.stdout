        ],
        "reason": "The original inner loop body calls U32X4.from on each four-byte chunk. Its exact lane-value contract discharges the four indexing obligations and byte widening.",
        "statement": null,
        "target": "adler2::algo::impl[16f54fa5277eca59]::from::Method",
        "theorem": null
      },
      {
        "goal": "adler2::adler32_slice::Function",
        "id": "lane_add",
        "kind": "contract",
        "needs": [],
        "reason": "The original inner body calls add_assign twice. Its full elementwise no-overflow contract supplies the two lane recurrences and checks all original indexing and scalar additions.",
        "statement": null,
        "target": "adler2::algo::impl[a6c2352d886692d1]::add_assign::Method",
        "theorem": null
      },
      {
        "goal": "adler2::adler32_slice::Function",
        "id": "inner_step",
        "kind": "lemma",
        "needs": [
          "lane_from",
          "lane_add"
        ],
        "reason": "The original compute_loop0_loop0.body has now been proved for a nonempty iterator, including consumption of the first chunk, exact a and b lane updates, and explicit overflow preconditions. This is the concrete body obligation for the missing inner loop invariant.",
        "statement": "∀ (bytes : Slice U8) (cs : List (Slice U8)) (rem : Slice U8) (a b : algo.U32X4) (hlen : 4 ≤ bytes.val.length) (ha : ∀ i : Nat, i < 4 → a.val[i]!.val + bytes.val[i]!.val ≤ U32.max) (hb : ∀ i : Nat, i < 4 → b.val[i]!.val + (a.val[i]!.val + bytes.val[i]!.val) ≤ U32.max), algo.Adler32.compute_loop0_loop0.body { chunks := bytes :: cs, remainder := rem } a b ⦃ fun r => ∃ av bv, r = .cont ({ chunks := cs, remainder := rem }, av, bv) ∧ (∀ i : Nat, i < 4 → av.val[i]!.val = a.val[i]!.val + bytes.val[i]!.val) ∧ (∀ i : Nat, i < 4 → bv.val[i]!.val = b.val[i]!.val + (a.val[i]!.val + bytes.val[i]!.val)) ⦄",
        "target": null,
        "theorem": "AdlerProof.inner_step"
      },
      {
        "goal": "adler2::adler32_slice::Function",
        "id": "inner_loop_bounded",
        "kind": "lemma",
        "needs": [
          "inner_step",
          "lane_budget"
        ],
        "reason": "The original full-chunk inner loop now has a complete all-iteration execution and exact lane-fold theorem. Prefix overflow safety is derived, not assumed, from actual residues <=65520 and at most 5552 chunks.",
        "statement": "∀ (cs : List (Slice U8)) (rem : Slice U8) (a b : algo.U32X4) (hchunks : ∀ c ∈ cs, 4 ≤ c.val.length) (hlen : cs.length ≤ 5552) (ha : ∀ i : Nat, i < 4 → a.val[i]!.val ≤ 65520) (hb : ∀ i : Nat, i < 4 → b.val[i]!.val ≤ 65520), algo.Adler32.compute_loop0_loop0 { chunks := cs, remainder := rem } a b ⦃ fun out => ∀ i : Nat, i < 4 → (out.1.val[i]!.val, out.2.val[i]!.val) = AdlerProof.laneRun cs a.val[i]!.val b.val[i]!.val i ⦄",
        "target": null,
        "theorem": "AdlerProof.inner_loop_bounded"
      },
      {
        "goal": "adler2::adler32_slice::Function",
        "id": "remainder_inner_loop_bounded",
        "kind": "lemma",
        "needs": [
          "inner_loop_bounded"
        ],
        "reason": "The original final-chunk inner loop is definitionally equal to the checked full-chunk inner loop; this theorem checks that equality and covers its complete execution with exact lane results.",
        "statement": "∀ (cs : List (Slice U8)) (rem : Slice U8) (a b : algo.U32X4) (hchunks : ∀ c ∈ cs, 4 ≤ c.val.length) (hlen : cs.length ≤ 5552) (ha : ∀ i : Nat, i < 4 → a.val[i]!.val ≤ 65520) (hb : ∀ i : Nat, i < 4 → b.val[i]!.val ≤ 65520), algo.Adler32.compute_loop1 { chunks := cs, remainder := rem } a b ⦃ fun out => ∀ i : Nat, i < 4 → (out.1.val[i]!.val, out.2.val[i]!.val) = AdlerProof.laneRun cs a.val[i]!.val b.val[i]!.val i ⦄",
        "target": null,
        "theorem": "AdlerProof.remainder_inner_loop_bounded"
      },
